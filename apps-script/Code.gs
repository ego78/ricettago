function setupRicettaGo(){const p=props_();let ss=p.getProperty("SPREADSHEET_ID")?SpreadsheetApp.openById(p.getProperty("SPREADSHEET_ID")):SpreadsheetApp.create("RicettaGo Database");p.setProperty("SPREADSHEET_ID",ss.getId());Object.keys(HEADERS).forEach(n=>ensureHeaders_(ss,n,HEADERS[n]));let f=p.getProperty("DRIVE_FOLDER_ID");if(!f){const folder=DriveApp.createFolder("RicettaGo Immagini");f=folder.getId();p.setProperty("DRIVE_FOLDER_ID",f)}Logger.log("Foglio: "+ss.getUrl());Logger.log("Drive: https://drive.google.com/drive/folders/"+f);return {spreadsheetId:ss.getId(),folderId:f}}
function ss_(){const id=props_().getProperty("SPREADSHEET_ID");if(!id)throw new Error("Esegui setupRicettaGo() una volta dall'editor Apps Script.");return SpreadsheetApp.openById(id)}
function ensureHeaders_(ss,name,headers){let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0){sh.getRange(1,1,1,headers.length).setValues([headers]);return sh}let current=sh.getRange(1,1,1,Math.max(sh.getLastColumn(),1)).getValues()[0].filter(String);const missing=headers.filter(h=>current.indexOf(h)<0);if(missing.length){sh.getRange(1,current.length+1,1,missing.length).setValues([missing])}return sh}
